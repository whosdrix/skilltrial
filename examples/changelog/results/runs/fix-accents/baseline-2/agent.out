ith `normalize('NFKD')` and strips the combining marks (`\\p{M}`) before lowercasing and replacing. So `è` becomes `e` instead of a dash.\n\nI changed two files:\n- `src/index.js`: added the normalize and strip steps.\n- `test/index.test.js`: added `assert.equal(slugify('Crème brûlée'), 'creme-brulee')` to the existing `slugify` test.\n\nI didn't commit anything. The `CHANGELOG.md` has a `slugify()` entry you may want to extend for this fix.","ttft_ms":1703,"type":"result","duration_ms":8537,"uuid":"54713b4b-e9bb-4bb4-8f10-3d90b3b668f3","ttft_stream_ms":1351,"time_to_request_ms":479,"time_to_request_phases_ms":{"other":7,"system_prompt":392,"resume_other":0,"process_user_input":3,"input_attachments":13,"input_hooks":2,"conversation_append":0,"tool_pool_refresh":2,"init_message":4,"init_frame_send":3,"engine_pickup":1,"loop_entry":3,"message_prep":2,"model_config_wait":9,"autocompact":2,"request_announcements":6,"query_setup":2,"model_gates":0,"tool_schema_build":16,"message_normalization":2,"client_creation":2,"request_build":8},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":51,"time_to_request_cpu_ms":130,"time_to_request_major_faults":0,"process_rss_mib_turn_start":205,"process_anon_mib_turn_start":126,"process_rss_mib_result":228,"process_anon_mib_result":137,"process_peak_rss_mib":233,"process_cpu_ms_turn":817,"process_wall_ms_turn":8536,"tool_pool_build_count":3,"tool_pool_build_lapsed_count":0,"tool_pool_moved_at_lapse_count":0,"tool_pool_limit_ms":30000,"process_cpu_ms_streaming":304,"process_wall_ms_streaming":4595,"main_stream_count":4,"main_stream_event_count":201,"main_stream_chunk_count":150,"process_turn_states":{"main_stream":{"cpu_ms":304,"wall_ms":4595,"entries":4},"tool":{"cpu_ms":60,"wall_ms":271,"entries":3},"first_event_wait":{"cpu_ms":257,"wall_ms":3133,"entries":4},"before_first_request":{"cpu_ms":130,"wall_ms":478,"entries":1},"between_requests":{"cpu_ms":60,"wall_ms":53,"entries":3},"after_last_request":{