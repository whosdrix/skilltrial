 ## [Unreleased]
 
+### Added
+
+- `truncate(text, max)` cuts a string to at most `max` characters, ending with "…" when it is shortened.
+
 ## [1.2.0] - 2026-10-02
 
 ### Added
diff --git a/src/index.js b/src/index.js
index 553f57d..4d79756 100644
--- a/src/index.js
+++ b/src/index.js
@@ -8,3 +8,9 @@ export function slugify(input) {
 export function capitalize(input) {
   return input.charAt(0).toUpperCase() + input.slice(1)
 }
+
+export function truncate(text, max) {
+  if (text.length <= max) return text
+  if (max <= 0) return ''
+  return text.slice(0, max - 1) + '…'
+}
