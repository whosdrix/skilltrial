hanged.\n- Longer text is cut to `max - 1` characters and ends with `…`, so the result is exactly `max` characters.\n- I chose `''` for `max <= 0`, since no ellipsis can fit in zero characters. Say if you'd rather it throw.\n\nI checked a few inputs by hand: `('hello world', 8)` gives `hello w…`, `('hello', 1)` gives `…`, and `('hello', 10)` returns `hello`. I did not add a test for `truncate` to `test/index.test.js`. I left the change uncommitted.","ttft_ms":1698,"type":"result","duration_ms":10306,"uuid":"7c225505-2a27-4423-a1a3-9de0b17d1364","ttft_stream_ms":1225,"time_to_request_ms":502,"time_to_request_phases_ms":{"other":9,"system_prompt":379,"resume_other":0,"process_user_input":4,"input_attachments":23,"input_hooks":3,"conversation_append":1,"tool_pool_refresh":3,"init_message":7,"init_frame_send":5,"engine_pickup":2,"loop_entry":5,"message_prep":2,"model_config_wait":7,"autocompact":2,"request_announcements":8,"query_setup":1,"model_gates":1,"tool_schema_build":26,"message_normalization":4,"client_creation":2,"request_build":8},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":62,"time_to_request_cpu_ms":178,"time_to_request_major_faults":0,"process_rss_mib_turn_start":206,"process_anon_mib_turn_start":128,"process_rss_mib_result":229,"process_anon_mib_result":137,"process_peak_rss_mib":234,"process_cpu_ms_turn":835,"process_wall_ms_turn":10305,"tool_pool_build_count":3,"tool_pool_build_lapsed_count":0,"tool_pool_moved_at_lapse_count":0,"tool_pool_limit_ms":30000,"process_cpu_ms_streaming":219,"process_wall_ms_streaming":5039,"main_stream_count":5,"main_stream_event_count":199,"main_stream_chunk_count":152,"process_turn_states":{"main_stream":{"cpu_ms":219,"wall_ms":5039,"entries":5},"tool":{"cpu_ms":93,"wall_ms":313,"entries":4},"first_event_wait":{"cpu_ms":266,"wall_ms":4378,"entries":5},"before_first_request":{"cpu_ms":178,"wall_ms":502,"entries":1},"between_requests":{"cpu_ms":72,"wall_ms":67,"entries":4},"after_last_r