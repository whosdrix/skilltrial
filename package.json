{
  "name": "skilltrial",
  "version": "0.1.0",
  "description": "Find out if an agent skill actually helps. Runs tasks with and without it, scores the results, and gives you a report card with real confidence intervals.",
  "license": "MIT",
  "author": "whosdrix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whosdrix/skilltrial.git"
  },
  "homepage": "https://github.com/whosdrix/skilltrial#readme",
  "bugs": "https://github.com/whosdrix/skilltrial/issues",
  "keywords": [
    "claude-code",
    "agent-skills",
    "skills",
    "evals",
    "benchmark",
    "llm",
    "ab-testing",
    "ai-agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "skilltrial": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
